<Window x:Class="TestGiveMeSpace.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True"
        Focusable="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonUp="Window_MouseRightButtonUp">
    <Border x:Name="PlaqueBorder" Background="#111111" BorderBrush="#111111" BorderThickness="4" Padding="16,6,8,6" CornerRadius="2" MinWidth="320">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MessageTextBlock"
                       Grid.Column="0"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap" />
            <Image x:Name="MouseIcon"
                   Grid.Column="1"
                   Source="Assets/Mouse.png"
                   Width="22"
                   Height="22"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   IsHitTestVisible="False"
                   Visibility="Hidden" />
            <Border x:Name="CloseMenu"
                    Grid.ColumnSpan="2"
                    Visibility="Collapsed"
                    Background="#222222"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    Padding="8,4"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    MouseLeftButtonDown="CloseMenu_MouseLeftButtonDown"
                    MouseLeftButtonUp="CloseMenu_MouseLeftButtonUp">
                <TextBlock Text="Закрыть"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontSize="12" />
            </Border>
        </Grid>
    </Border>
</Window>
